# VITALOOP 1.3 — Exemplo de variáveis de ambiente (NÃO contém segredos reais)
# Copie para .env (que é git-ignored) e preencha localmente.
# NUNCA versionar .env real (Doc 2 §60).

# --- Aplicação ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- CORS (negar por padrão; lista separada por vírgula) ---
CORS_ALLOWED_ORIGINS=

# --- Banco de dados (PostgreSQL) ---
# Na Fase 0 aponte para um Postgres LOCAL (ex.: docker/compose).
# NÃO usar credenciais de produção nem de outros projetos.
# Deixe vazio para rodar a API sem banco (readiness reportará db: not_configured).
DATABASE_URL=

# --- Contexto de segurança usado pelas políticas RLS (aplicado por request) ---
# Nomes das GUC settings que a aplicação seta por transação. Apenas referência.
# vitaloop.user_id, vitaloop.institution_id, vitaloop.unit_id, vitaloop.sector_id,
# vitaloop.roles, vitaloop.break_glass

