@@ -0,0 +1,253 @@
+/*
+ * VITALOOP — sistema de design base.
+ *
+ * Contexto de uso: profissionais de saúde em plantão de UPA 24h, muitas vezes
+ * sob pressão de tempo e cansaço visual. Prioridade: legibilidade, densidade
+ * de informação, contraste alto, zero ambiguidade — não decoração.
+ *
+ * As cores clínicas de risco (Protocolo de Manchester: vermelho/laranja/
+ * amarelo/verde/azul) são dado clínico, não tema visual — permanecem
+ * definidas onde são usadas (ex.: QueueDashboardPage) e nunca são
+ * redefinidas aqui, para não colidir com o significado clínico.
+ *
+ * Esta folha estiliza elementos HTML nativos (form, input, button, table...)
+ * para que toda tela que hoje não tem nenhum CSS próprio herde uma
+ * aparência consistente automaticamente, sem precisar editar cada arquivo.
+ * Estilos inline existentes (ex.: badges de risco, botões de ação semântica)
+ * continuam funcionando normalmente — inline sempre vence sobre estas regras.
+ */
+
+:root {
+  /* Cor — paleta clínica, fria, de alto contraste */
+  --color-bg: #f4f6f8;
+  --color-surface: #ffffff;
+  --color-surface-sunken: #eef2f4;
+  --color-border: #d7e0e6;
+  --color-border-strong: #aebdc7;
+  --color-text: #12232d;
+  --color-text-muted: #52707f;
+  --color-text-faint: #7c8f99;
+
+  --color-primary: #0e5c74;
+  --color-primary-hover: #0a4a5d;
+  --color-primary-soft: #e2eff2;
+
+  --color-danger: #a4241c;
+  --color-danger-soft: #fbe9e7;
+  --color-success: #1f6f45;
+  --color-success-soft: #e6f4ea;
+  --color-warning: #8a5a00;
+  --color-warning-soft: #fdf1dc;
+
+  --color-focus-ring: #0e5c74;
+
+  /* Tipografia */
+  --font-ui: 'Public Sans', 'Segoe UI', system-ui, -apple-system, sans-serif;
+  --font-mono: 'IBM Plex Mono', 'SFMono-Regular', Consolas, monospace;
+
+  --text-xs: 0.8125rem;
+  --text-sm: 0.875rem;
+  --text-base: 0.9375rem;
+  --text-lg: 1.0625rem;
+  --text-xl: 1.25rem;
+  --text-2xl: 1.5rem;
+
+  /* Espaçamento */
+  --space-1: 4px;
+  --space-2: 8px;
+  --space-3: 12px;
+  --space-4: 16px;
+  --space-5: 24px;
+  --space-6: 32px;
+
+  --radius-sm: 6px;
+  --radius-md: 8px;
+
+  --shadow-card: 0 1px 2px rgba(18, 35, 45, 0.06);
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  :root {
+    --transition-fast: 120ms ease;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  * {
+    animation-duration: 0.001ms !important;
+    transition-duration: 0.001ms !important;
+  }
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--color-bg);
+  color: var(--color-text);
+  font-family: var(--font-ui);
+  font-size: var(--text-base);
+  line-height: 1.5;
+  -webkit-font-smoothing: antialiased;
+}
+
+h1, h2, h3, h4 {
+  font-family: var(--font-ui);
+  font-weight: 700;
+  line-height: 1.25;
+  margin: 0 0 var(--space-3) 0;
+  color: var(--color-text);
+}
+h1 { font-size: var(--text-2xl); }
+h2 { font-size: var(--text-xl); }
+h3 { font-size: var(--text-lg); }
+h4 { font-size: var(--text-base); font-weight: 600; }
+
+p { margin: 0 0 var(--space-3) 0; }
+
+a {
+  color: var(--color-primary);
+  text-decoration: none;
+}
+a:hover { text-decoration: underline; }
+
+/* Foco visível sempre — essencial em ambiente clínico, teclado/leitor de tela */
+:focus-visible {
+  outline: 2px solid var(--color-focus-ring);
+  outline-offset: 2px;
+  border-radius: var(--radius-sm);
+}
+
+/* Conteúdo principal de cada rota — a maioria das páginas de hoje é
+   <main>...</main> direto, sem wrapper próprio; isso dá a moldura padrão. */
+main {
+  display: block;
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: var(--space-5);
+}
+main > h1:first-child {
+  padding-bottom: var(--space-3);
+  border-bottom: 1px solid var(--color-border);
+  margin-bottom: var(--space-4);
+}
+
+form {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-1);
+  max-width: 480px;
+  background: var(--color-surface);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-md);
+  padding: var(--space-5);
+  box-shadow: var(--shadow-card);
+}
+
+label {
+  font-size: var(--text-xs);
+  font-weight: 600;
+  color: var(--color-text-muted);
+  margin-top: var(--space-3);
+}
+
+input, select, textarea {
+  font-family: var(--font-ui);
+  font-size: var(--text-base);
+  color: var(--color-text);
+  background: var(--color-surface);
+  border: 1px solid var(--color-border-strong);
+  border-radius: var(--radius-sm);
+  padding: 8px 10px;
+  width: 100%;
+}
+input::placeholder, textarea::placeholder {
+  color: var(--color-text-faint);
+}
+input:focus, select:focus, textarea:focus {
+  border-color: var(--color-primary);
+}
+input:disabled, select:disabled, textarea:disabled {
+  background: var(--color-surface-sunken);
+  color: var(--color-text-faint);
+}
+
+button {
+  font-family: var(--font-ui);
+  font-size: var(--text-sm);
+  font-weight: 600;
+  color: #ffffff;
+  background: var(--color-primary);
+  border: none;
+  border-radius: var(--radius-sm);
+  padding: 9px 16px;
+  margin-top: var(--space-4);
+  cursor: pointer;
+  transition: background var(--transition-fast, 0ms);
+}
+button:hover:not(:disabled) { background: var(--color-primary-hover); }
+button:disabled { background: var(--color-border-strong); cursor: not-allowed; }
+
+/* Links de ação secundária que aparecem como <a> soltos após formulários
+   (ex.: "Esqueci minha senha") não devem herdar o espaçamento de form. */
+form + a, main > a {
+  display: inline-block;
+  margin-top: var(--space-3);
+  font-size: var(--text-sm);
+}
+
+table {
+  width: 100%;
+  border-collapse: collapse;
+  background: var(--color-surface);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-md);
+  overflow: hidden;
+  box-shadow: var(--shadow-card);
+}
+thead {
+  background: var(--color-surface-sunken);
+}
+th {
+  text-align: left;
+  font-size: var(--text-xs);
+  font-weight: 700;
+  text-transform: none;
+  color: var(--color-text-muted);
+  padding: var(--space-3);
+  border-bottom: 1px solid var(--color-border);
+}
+td {
+  padding: var(--space-3);
+  border-bottom: 1px solid var(--color-border);
+  font-size: var(--text-sm);
+}
+tbody tr:last-child td { border-bottom: none; }
+tbody tr:hover { background: var(--color-surface-sunken); }
+
+/* Dado clínico/identificador — números de senha, IDs, CPF, timestamps */
+.vl-mono, td.vl-mono, .mono {
+  font-family: var(--font-mono);
+}
+
+[role='alert'] {
+  background: var(--color-danger-soft);
+  color: var(--color-danger);
+  border: 1px solid var(--color-danger);
+  border-radius: var(--radius-sm);
+  padding: var(--space-3);
+  font-size: var(--text-sm);
+  margin-bottom: var(--space-3);
+}
+
+[role='status'] {
+  color: var(--color-text-muted);
+  font-size: var(--text-sm);
+}
